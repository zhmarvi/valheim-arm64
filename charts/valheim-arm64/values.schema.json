{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "valheim-arm64 chart values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        ]
      }
    },
    "server": {
      "type": "object",
      "required": ["name", "worldName", "port", "public", "crossplay", "updateOnStart", "saveInterval", "backups", "password", "existingSecret"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "worldName": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1024, "maximum": 65533 },
        "public": { "type": "integer", "enum": [0, 1] },
        "crossplay": { "type": "boolean" },
        "updateOnStart": { "type": "boolean" },
        "saveInterval": { "type": "integer", "minimum": 0 },
        "backups": {
          "type": "object",
          "required": ["count", "shortInterval", "longInterval"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "shortInterval": { "type": "integer", "minimum": 0 },
            "longInterval": { "type": "integer", "minimum": 0 }
          }
        },
        "password": {
          "type": "string",
          "oneOf": [
            { "maxLength": 0 },
            { "minLength": 5 }
          ]
        },
        "existingSecret": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string" },
            "key": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "nodePorts"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "annotations": { "type": "object" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "loadBalancerClass": { "type": "string" },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } },
        "externalTrafficPolicy": { "type": "string", "enum": ["", "Cluster", "Local"] },
        "allocateLoadBalancerNodePorts": { "type": ["boolean", "null"] },
        "nodePorts": {
          "type": "object",
          "properties": {
            "game": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 },
            "query": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 },
            "steam": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 }
          }
        }
      }
    },
    "headlessService": {
      "type": "object",
      "properties": {
        "annotations": { "type": "object" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "publishNotReadyAddresses": { "type": "boolean" }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["server", "config"],
      "properties": {
        "server": { "$ref": "#/definitions/persistence" },
        "config": { "$ref": "#/definitions/persistence" }
      }
    },
    "automountServiceAccountToken": { "type": "boolean" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "resources": { "type": "object" },
    "startupProbe": { "$ref": "#/definitions/probe" },
    "readinessProbe": { "$ref": "#/definitions/probe" },
    "livenessProbe": { "$ref": "#/definitions/probe" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "updateStrategy": {
      "type": "object",
      "required": ["type"],
      "properties": { "type": { "type": "string", "enum": ["RollingUpdate", "OnDelete"] } }
    },
    "restartCronJob": {
      "type": "object",
      "required": ["enabled", "schedule", "timeZone", "concurrencyPolicy", "suspend", "startingDeadlineSeconds", "successfulJobsHistoryLimit", "failedJobsHistoryLimit", "backoffLimit", "ttlSecondsAfterFinished", "image", "podAnnotations", "podLabels", "podSecurityContext", "containerSecurityContext", "resources", "nodeSelector", "tolerations", "affinity"],
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string", "minLength": 1 },
        "timeZone": { "type": "string", "minLength": 1 },
        "concurrencyPolicy": { "type": "string", "enum": ["Allow", "Forbid", "Replace"] },
        "suspend": { "type": "boolean" },
        "startingDeadlineSeconds": { "type": "integer", "minimum": 0 },
        "successfulJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "failedJobsHistoryLimit": { "type": "integer", "minimum": 0 },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
        "image": {
          "type": "object",
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$" },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "podAnnotations": { "type": "object" },
        "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "podSecurityContext": { "type": "object" },
        "containerSecurityContext": { "type": "object" },
        "resources": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" }
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "runtimeClassName": { "type": "string" },
    "schedulerName": { "type": "string" },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "emptyDir": { "type": "object" },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" }
  },
  "definitions": {
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size", "annotations", "selector"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "size": { "type": "string", "pattern": "^[0-9]+([.][0-9]+)?([EPTGMK]i?|m)?$" },
        "annotations": { "type": "object" },
        "selector": { "type": "object" }
      }
    },
    "probe": {
      "type": "object",
      "required": ["enabled", "failureThreshold", "periodSeconds", "timeoutSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
